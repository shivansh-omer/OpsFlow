generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER
  MEMBER
  LEAD
  ADMIN
}

enum WorkItemType {
  TASK
  BUG
  INCIDENT
  OPERATIONAL_REQUEST
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum ActivityAction {
  CREATED
  CLAIMED
  ASSIGNED
  STATUS_CHANGED
  APPROVED
  REJECTED
  COMMENTED
  UPDATED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String
  passwordHash       String
  avatarUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  memberships        TeamMember[]
  createdWorkItems   WorkItem[]          @relation("CreatedWorkItems")
  assignedWorkItems  WorkItem[]          @relation("AssignedWorkItems")
  comments           Comment[]
  activities         ActivityLog[]
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

model Team {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members     TeamMember[]
  workItems   WorkItem[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("team_members")
}

model WorkItem {
  id          String           @id @default(uuid())
  title       String
  description String           @db.Text
  type        WorkItemType     @default(TASK)
  priority    WorkItemPriority @default(MEDIUM)
  status      WorkItemStatus   @default(OPEN)
  teamId      String
  creatorId   String
  assigneeId  String?
  dueDate     DateTime?
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  team        Team             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  creator     User             @relation("CreatedWorkItems", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee    User?            @relation("AssignedWorkItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  activities  ActivityLog[]

  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([priority, status])
  @@index([teamId, priority, status])
  @@map("work_items")
}

model Comment {
  id         String   @id @default(uuid())
  workItemId String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
  @@map("comments")
}

model ActivityLog {
  id         String         @id @default(uuid())
  workItemId String
  actorId    String
  action     ActivityAction
  oldValue   String?
  newValue   String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  workItem   WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor      User           @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
  @@map("activity_logs")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String
  userId       String
  fingerprint  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([expiresAt])
  @@map("idempotency_records")
}
